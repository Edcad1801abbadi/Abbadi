#!/usr/bin/env bash

##############################################################################
##
##  Gradle start up script for UN*X
##
##############################################################################

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS=""

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")

# Use the maximum available, or set MAX_FD to match ulimit -n value.
MAX_FD="maximum"

case "$(uname)" in
  CYGWIN*)
    isWindows=true
    ;;
  Darwin*)
    isDarwin=true
    ;;
  MINGW*)
    isWindows=true
    ;;
esac

if [ "$isDarwin" = true ] && [ "$JAVA_HOME" = '' ]; then
  export JAVA_HOME="$(/usr/libexec/java_home)"
fi

if [ "$isWindows" = true ]; then
  [ -n "$JAVA_HOME" ] && JAVA_HOME="$(cd "$JAVA_HOME" && pwd -W | tr '\\\\' '/')"
fi

exec "$JAVA_HOME/bin/java" $DEFAULT_JVM_OPTS $JAVA_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
